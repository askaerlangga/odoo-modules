<odoo>
    <record id="module_category_approval_matrix" model="ir.module.category">
        <field name="name">Approval Matrix</field>
        <field name="description">Manage multi-tier approval matrices and rules across any model.</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_approval_matrix" model="res.groups.privilege">
        <field name="name">Approval Matrix Access</field>
        <field name="category_id" ref="module_category_approval_matrix"/>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_approval_matrix"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_approval_matrix"/>
        <field name="implied_ids" eval="[Command.link(ref('group_approval_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
