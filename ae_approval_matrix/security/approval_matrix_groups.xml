<odoo>
    <record id="module_category_approval_matrix" model="ir.module.category">
        <field name="name">Approval Matrix</field>
        <field name="description">Manage multi-tier approval matrices and rules across any model.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_approval_matrix"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_approval_matrix"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
