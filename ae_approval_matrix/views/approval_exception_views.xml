<odoo>
    <!-- ─── approval.exception ─── -->
    <record id="view_approval_exception_tree" model="ir.ui.view">
        <field name="name">approval.exception.list</field>
        <field name="model">approval.exception</field>
        <field name="arch" type="xml">
            <list string="Field Edit Exceptions">
                <field name="name"/>
                <field name="model_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="field_ids" widget="many2many_tags"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="allow_write_under_validation"/>
                <field name="allow_write_after_validation"/>
            </list>
        </field>
    </record>

    <record id="view_approval_exception_form" model="ir.ui.view">
        <field name="name">approval.exception.form</field>
        <field name="model">approval.exception</field>
        <field name="arch" type="xml">
            <form string="Field Edit Exception">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Exception Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Allow Editing Notes During Validation"/>
                        </h1>
                    </div>
                    <group>
                        <group name="target_model" string="Target Model">
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="permissions" string="Permissions &amp; Scope">
                            <field name="allow_write_under_validation"/>
                            <field name="allow_write_after_validation"/>
                            <field name="group_ids" widget="many2many_tags"
                                placeholder="All users if empty"/>
                        </group>
                    </group>
                    <group string="Allowed Fields (Editable during the specified phases)">
                        <field name="field_ids" widget="many2many_tags" nolabel="1"
                            domain="[('model_id', '=', model_id)]"
                            options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_exception_search" model="ir.ui.view">
        <field name="name">approval.exception.search</field>
        <field name="model">approval.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <group>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_exception" model="ir.actions.act_window">
        <field name="name">Field Edit Exceptions</field>
        <field name="res_model">approval.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_exception_search"/>
    </record>
</odoo>
