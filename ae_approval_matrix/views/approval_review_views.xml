<odoo>
    <!-- ─── approval.review ─── -->
    <record id="view_approval_review_tree_dialog" model="ir.ui.view">
        <field name="name">approval.review.list.dialog</field>
        <field name="model">approval.review</field>
        <field name="arch" type="xml">
            <list string="Approval History" default_order="sequence, id" create="false" edit="false" delete="false"
                  decoration-success="status == 'approved'"
                  decoration-danger="status == 'rejected'"
                  decoration-info="status == 'pending'"
                  decoration-muted="status in ('waiting', 'cancel')">
                <field name="sequence" string="Level"/>
                <field name="approver_ids" widget="many2many_tags" string="Assigned Approvers"/>
                <field name="name" string="Description"/>
                <field name="minimum_approved" string="Min. Required"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"
                       decoration-info="status == 'pending'"
                       decoration-muted="status in ('waiting', 'cancel')"/>
                <field name="reviewed_users_display" string="Reviewed By"/>
                <field name="action_datetime" string="Action Date"/>
                <field name="comment" string="Comment"/>
                <field name="rejection_reason" string="Rejection Reason"/>
            </list>
        </field>
    </record>

    <record id="view_approval_review_tree" model="ir.ui.view">
        <field name="name">approval.review.list</field>
        <field name="model">approval.review</field>
        <field name="arch" type="xml">
            <list string="Approval Reviews" default_order="sequence, id" create="false" edit="false">
                <header>
                    <button name="action_bulk_approve_wizard" type="object"
                        string="Approve Selected" class="btn-success" icon="fa-check"/>
                    <button name="action_bulk_reject_wizard" type="object"
                        string="Reject Selected" class="btn-danger" icon="fa-times"/>
                </header>
                <field name="sequence" string="Level"/>
                <field name="res_name" string="Document"/>
                <field name="res_model" string="Model"/>
                <field name="approver_ids" widget="many2many_tags" string="Assigned Approvers"/>
                <field name="name" string="Description"/>
                <field name="minimum_approved" string="Min. Required"/>
                <field name="approved_by_ids" widget="many2many_tags"/>
                <field name="rejected_by_ids" widget="many2many_tags"/>
                <field name="delegated_info" optional="hide"/>
                <field name="sla_deadline" optional="show"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'approved'"
                    decoration-danger="status == 'rejected'"
                    decoration-info="status == 'pending'"
                    decoration-muted="status in ('waiting', 'cancel')"/>
                <field name="action_datetime" string="Action Date"/>
                <button name="action_open_document" type="object"
                    string="Open Document" icon="fa-external-link"
                    class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_approval_review_form" model="ir.ui.view">
        <field name="name">approval.review.form</field>
        <field name="model">approval.review</field>
        <field name="arch" type="xml">
            <form string="Approval Review" create="false" edit="false">
                <field name="user_can_approve" invisible="1"/>
                <header>
                    <button name="action_open_document" type="object"
                        string="Open Source Document"
                        class="btn-primary" icon="fa-external-link"/>
                    <button name="action_approve" type="object"
                        string="Approve"
                        invisible="not user_can_approve"
                        class="btn-success"/>
                    <button name="action_reject" type="object"
                        string="Reject"
                        invisible="not user_can_approve"
                        class="btn-danger"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="waiting,pending,approved,rejected"
                        readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Description"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="doc_info" string="Document Details">
                            <field name="res_name" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="matrix_id" readonly="1" string="Approval Matrix"/>
                            <field name="sequence" readonly="1"/>
                        </group>
                        <group name="quorum_info" string="Review Quorum &amp; Activity">
                            <field name="minimum_approved" readonly="1"/>
                            <field name="approved_count" readonly="1"/>
                            <field name="rejected_count" readonly="1"/>
                            <field name="pending_date" readonly="1" invisible="not pending_date"/>
                            <field name="sla_deadline" readonly="1" invisible="not sla_deadline"/>
                            <field name="action_datetime" readonly="1"/>
                        </group>
                    </group>
                    <group string="Assigned Approvers">
                        <field name="approver_ids" widget="many2many_tags" nolabel="1" readonly="1" colspan="2"/>
                    </group>
                    <group string="Approved By" invisible="not approved_by_ids">
                        <group>
                            <field name="approved_by_ids" widget="many2many_tags" readonly="1"/>
                            <field name="on_behalf_of_ids" widget="many2many_tags" readonly="1" invisible="not on_behalf_of_ids"/>
                            <field name="delegated_info" readonly="1" invisible="not delegated_info"/>
                        </group>
                        <group>
                            <field name="comment" readonly="1" invisible="not comment"/>
                        </group>
                    </group>
                    <group string="Rejected By" invisible="not rejected_by_ids">
                        <group>
                            <field name="rejected_by_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_approval_review_search" model="ir.ui.view">
        <field name="name">approval.review.search</field>
        <field name="model">approval.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_name" string="Document"/>
                <field name="name" string="Description"/>
                <field name="res_model"/>
                <field name="approver_ids"/>
                <filter name="my_pending" string="My Pending Approvals"
                    domain="[('approver_ids', 'in', [uid]), ('status', '=', 'pending'), ('approved_by_ids', 'not in', [uid])]"/>
                <filter name="all_pending" string="All Pending"
                    domain="[('status', '=', 'pending')]"/>
                <filter name="waiting" string="Waiting"
                    domain="[('status', '=', 'waiting')]"/>
                <filter name="approved" string="Approved"
                    domain="[('status', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected"
                    domain="[('status', '=', 'rejected')]"/>
                <separator/>
                <group>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'res_model'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_matrix" string="Approval Matrix" context="{'group_by': 'matrix_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_review" model="ir.actions.act_window">
        <field name="name">All Approval Reviews</field>
        <field name="res_model">approval.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_review_search"/>
        <field name="context">{'search_default_all_pending': 1}</field>
    </record>

    <record id="action_my_approval_review" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">approval.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_review_search"/>
        <field name="domain">[('approver_ids', 'in', [uid]), ('status', '=', 'pending'), ('approved_by_ids', 'not in', [uid])]</field>
        <field name="context">{'search_default_my_pending': 1}</field>
    </record>

    <record id="action_server_bulk_approve_reviews" model="ir.actions.server">
        <field name="name">Approve Selected Reviews</field>
        <field name="model_id" ref="model_approval_review"/>
        <field name="binding_model_id" ref="model_approval_review"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_approve_wizard()</field>
    </record>

    <record id="action_server_bulk_reject_reviews" model="ir.actions.server">
        <field name="name">Reject Selected Reviews</field>
        <field name="model_id" ref="model_approval_review"/>
        <field name="binding_model_id" ref="model_approval_review"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_bulk_reject_wizard()</field>
    </record>
</odoo>