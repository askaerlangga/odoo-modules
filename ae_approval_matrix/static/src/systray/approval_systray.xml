<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ae_approval_matrix.ApprovalSystray">
        <Dropdown position="'bottom-end'"
                  autoOpen="false"
                  beforeOpen.bind="onBeforeOpen"
                  class="'o_ae_approval_systray d-flex align-items-center h-100'"
                  togglerClass="'position-relative'"
                  menuClass="'p-0 o_ae_approval_menu shadow-lg border-0 rounded-2'"
                  title="'Pending Approvals'">
            <t t-set-slot="toggler">
                <i class="fa fa-check-square-o fa-lg" role="img" aria-label="Pending Approvals"/>
                <span t-if="state.count > 0" class="badge rounded-pill bg-danger position-absolute top-0 start-50 translate-middle-x">
                    <t t-esc="state.count"/>
                </span>
            </t>
            <t t-set-slot="default">
                <div class="d-flex flex-column bg-view">
                    <!-- Header -->
                    <div class="o_ae_approval_header d-flex align-items-center justify-content-between px-3 py-2">
                        <span class="fw-bold text-dark">Pending Approvals</span>
                        <button type="button"
                                class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold"
                                t-on-click="openMyApprovals">
                            View All
                        </button>
                    </div>

                    <!-- List Items -->
                    <div class="o_ae_approval_items list-group list-group-flush">
                        <!-- Empty State -->
                        <div t-if="state.reviews.length === 0" class="text-center py-4 px-3 text-muted">
                            <i class="fa fa-check-circle-o fa-3x text-success mb-2 d-block"/>
                            <div class="fw-semibold">All caught up!</div>
                            <div class="small">No pending approvals waiting for your review.</div>
                        </div>

                        <!-- Review Items -->
                        <t t-foreach="state.reviews" t-as="review" t-key="review.id">
                            <div class="o_ae_approval_item list-group-item list-group-item-action d-flex align-items-center px-3 py-2"
                                 t-att-title="'Open ' + (review.res_name || review.model_name)"
                                 t-on-click="() => this.openReview(review)">
                                <!-- Avatar Icon -->
                                <div class="o_ae_approval_avatar me-3 flex-shrink-0">
                                    <i class="fa fa-file-text-o"/>
                                </div>
                                <!-- Details -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="fw-bold text-dark text-truncate me-2" t-esc="review.res_name"/>
                                        <span class="text-muted small text-nowrap" t-esc="review.time_ago"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-1">
                                        <span class="text-muted small text-truncate">
                                            <t t-esc="review.model_name"/> • <t t-esc="review.name"/>
                                        </span>
                                        <span t-if="review.minimum_approved > 1"
                                              class="badge rounded-pill bg-secondary text-white ms-2 text-nowrap"
                                              title="Quorum approval progress"
                                              style="font-size: 0.68rem;">
                                            <t t-esc="review.approved_count"/>/<t t-esc="review.minimum_approved"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Footer -->
                    <div t-if="state.count > 0" class="o_ae_approval_footer p-2 text-center">
                        <button type="button"
                                class="btn btn-sm btn-link w-100 fw-bold text-decoration-none"
                                t-on-click="openMyApprovals">
                            View All Pending Approvals (<t t-esc="state.count"/>)
                        </button>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
