<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="approval_buttons">
        <div>
            <field name="approval_state" invisible="1"/>
            <field name="approval_need_validation" invisible="1"/>
            <field name="approval_user_can_approve" invisible="1"/>
            <field name="approval_can_restart" invisible="1"/>
            <field name="approval_next_review" invisible="1"/>
            <button name="action_request_approval" string="Request Approval"
                    type="object" class="btn-primary"
                    invisible="not approval_need_validation or approval_state != 'draft'"/>
            <button name="action_approve_matrix" string="Approve"
                    type="object" class="btn-success"
                    invisible="not approval_user_can_approve"/>
            <button name="action_reject_matrix" string="Reject"
                    type="object" class="btn-danger"
                    invisible="not approval_user_can_approve"/>
            <button name="action_restart_approval" string="Restart Validation"
                    type="object" class="btn-secondary"
                    invisible="not approval_can_restart"/>
        </div>
    </template>

    <template id="approval_label">
        <div>
            <div class="alert alert-warning mb-0 py-2" role="alert"
                 invisible="not approval_need_validation or approval_state != 'draft'">
                <div class="d-flex align-items-center">
                    <i class="fa fa-exclamation-circle me-2"/>
                    <span>
                        <b>Approval Required:</b> This document requires approval before confirmation. Click <b>Request Approval</b> to submit for review.
                    </span>
                </div>
            </div>
            <div class="alert alert-info mb-0 py-2" role="alert"
                 invisible="approval_state not in ('waiting', 'pending')">
                <div class="d-flex align-items-center">
                    <i class="fa fa-hourglass-half me-2"/>
                    <span>
                        <b>Approval in Progress:</b> Waiting for validation (<field name="approval_next_review" readonly="1" class="fw-bold d-inline"/>).
                    </span>
                </div>
            </div>
            <div class="alert alert-success mb-0 py-2" role="alert"
                 invisible="approval_state != 'approved'">
                <div class="d-flex align-items-center">
                    <i class="fa fa-check-circle me-2"/>
                    <span>
                        <b>Approved:</b> All required approval levels have been granted.
                    </span>
                </div>
            </div>
            <div class="alert alert-danger mb-0 py-2" role="alert"
                 invisible="approval_state != 'rejected'">
                <div class="d-flex align-items-center">
                    <i class="fa fa-times-circle me-2"/>
                    <span>
                        <b>Rejected:</b> Document was rejected. Click <b>Restart Validation</b> to revise and re-submit.
                    </span>
                </div>
            </div>
            <div class="alert alert-secondary mb-0 py-2" role="alert"
                 invisible="approval_state != 'cancel'">
                <div class="d-flex align-items-center">
                    <i class="fa fa-ban me-2"/>
                    <span>
                        <b>Cancelled:</b> Document approval was cancelled.
                    </span>
                </div>
            </div>
        </div>
    </template>

    <template id="approval_reviews">
        <div>
            <field name="approval_review_ids" invisible="not approval_review_ids" readonly="1" class="w-100 mt-2">
                <tree create="0" delete="0" edit="0"
                      decoration-success="status == 'approved'"
                      decoration-danger="status == 'rejected'"
                      decoration-info="status == 'pending'"
                      decoration-muted="status == 'waiting'">
                    <field name="sequence" string="Level"/>
                    <field name="approver_ids" widget="many2many_tags" string="Assigned Approvers"/>
                    <field name="name" string="Description"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'approved'"
                           decoration-danger="status == 'rejected'"
                           decoration-info="status == 'pending'"
                           decoration-muted="status == 'waiting'"/>
                    <field name="reviewed_users_display" string="Reviewed By"/>
                    <field name="action_datetime" string="Action Date"/>
                    <field name="comment" string="Comment"/>
                    <field name="rejection_reason" string="Rejection Reason"/>
                </tree>
            </field>
        </div>
    </template>

    <template id="approval_list_fields">
        <div>
            <field name="approval_state" column_invisible="1"/>
            <field name="approval_need_validation" column_invisible="1"/>
            <field name="approval_user_can_approve" column_invisible="1"/>
            <field name="approval_can_restart" column_invisible="1"/>
        </div>
    </template>

    <template id="approval_list_status">
        <div>
            <field name="approval_state" string="Approval" widget="badge" optional="show" readonly="1"
                   decoration-success="approval_state == 'approved'"
                   decoration-danger="approval_state == 'rejected'"
                   decoration-warning="approval_state in ('waiting', 'pending')"
                   decoration-info="approval_state == 'draft' and approval_need_validation"
                   decoration-muted="approval_state in ('draft', 'cancel')"/>
        </div>
    </template>

    <template id="approval_list_buttons">
        <div>
            <button name="action_view_approval_history" type="object"
                    icon="fa-history text-info" string="History" title="View Approval History"
                    invisible="not approval_need_validation or approval_state == 'draft'"/>
            <button name="action_request_approval" type="object"
                    icon="fa-paper-plane" string="Request" title="Request Approval"
                    invisible="not approval_need_validation or approval_state != 'draft'"/>
            <button name="action_approve_matrix" type="object"
                    icon="fa-check text-success" string="Approve" title="Approve"
                    invisible="not approval_user_can_approve"/>
            <button name="action_reject_matrix" type="object"
                    icon="fa-times text-danger" string="Reject" title="Reject"
                    invisible="not approval_user_can_approve"/>
            <button name="action_restart_approval" type="object"
                    icon="fa-undo" string="Restart" title="Restart Validation"
                    invisible="not approval_can_restart"/>
        </div>
    </template>
</odoo>
