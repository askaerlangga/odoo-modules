<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Locations View: Prevent auto-apply bypass when approval is required -->
    <record id="view_stock_quant_tree_editable_inherit_approval" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.inherit.approval</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="attributes">
                <attribute name="readonly">approval_need_validation and approval_state in ('waiting', 'pending')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
